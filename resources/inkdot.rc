// Inkdot / 墨点 Windows resource file
#pragma code_page(65001)

IDI_ICON1 ICON "inkdot.ico"

#ifndef INKDOT_VERSION_MAJOR
#define INKDOT_VERSION_MAJOR 0
#endif
#ifndef INKDOT_VERSION_MINOR
#define INKDOT_VERSION_MINOR 0
#endif
#ifndef INKDOT_VERSION_PATCH
#define INKDOT_VERSION_PATCH 0
#endif

#define INKDOT_STR_HELPER(x) #x
#define INKDOT_STR(x) INKDOT_STR_HELPER(x)
#define INKDOT_VERSION_STRING \
    INKDOT_STR(INKDOT_VERSION_MAJOR) "." \
    INKDOT_STR(INKDOT_VERSION_MINOR) "." \
    INKDOT_STR(INKDOT_VERSION_PATCH)

1 VERSIONINFO
FILEVERSION     INKDOT_VERSION_MAJOR,INKDOT_VERSION_MINOR,INKDOT_VERSION_PATCH,0
PRODUCTVERSION  INKDOT_VERSION_MAJOR,INKDOT_VERSION_MINOR,INKDOT_VERSION_PATCH,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "RickChen764"
            VALUE "FileDescription",  "Inkdot - tiny native Markdown reader and editor"
            VALUE "FileVersion",      INKDOT_VERSION_STRING
            VALUE "InternalName",     "inkdot"
            VALUE "LegalCopyright",   "Copyright (c) oipoistar and Inkdot contributors. MIT License."
            VALUE "OriginalFilename", "inkdot.exe"
            VALUE "ProductName",      "墨点 Inkdot"
            VALUE "ProductVersion",   INKDOT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
